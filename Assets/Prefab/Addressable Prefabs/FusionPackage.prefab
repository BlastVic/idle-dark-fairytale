MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 747305216783422672}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e87c67080d7d14d2786d3a5435e56324, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  statueAnim: {fileID: 5880552165074320974}
  bubble1: {fileID: 1539073460068768475}
  bubble2: {fileID: 1735831433809367778}
  bubble1Text: {fileID: 8318490168295214800}
  bubble2Text: {fileID: 7214769222414430704}
  bigTexts:
  - I smell crystals. Hand them over to the greatest idol.
  - I sense a great fear in you - feed me crystals, or else!
  - The time has come for you to strengthen your fusion. Crystal me, Now!
  - I need to eat. I'm famished. Hand over those crystals.
  - Dont use my name in vain. Now hand over those crystals boi!
  - I sense great disturbance in the force. I'm about to release my full fury if
    I don't get to eat.
  - I have socks older than you little one. Care to feed an old geezer some crystals?
  - Oh look who the wind blew in. What you got there in your tiny hands? Are those
    crystals for me?
  - Well, well, well. Look who moma let out to play. Got something for me?
  - I'm the only way for you to reach ever higher fusion levels boi!
  littleTexts:
  - I have stood here for millenia, eating crystals.
  - You see my big teeth? Let them crunch crystals!
  - Please place crystals in my mouth for a blessing.
  - Once you start there's no going back little one.
  - Still waiting? Wait faster. Crystals. Hand them over at once.
  - I dont take jokes seriously when I'm hungry.
  - It's either you or the crystals. What it gonna be huh?
  - One way or another I'm gonna eat something!
  - Come closer, don't be afraid, unless you don't have any crystals for me that
    is.
  - Let me see your pockets. I have a good nose for crystals.
  finishingTexts:
  - Ooohh, delicious!
  - Yum yum... crystals!
  - I could eat them all if you let me.
  - Fusion blessing is yours!
  - That was tasty...*Braaaap!
  - Coming from you that means a lot.
  - I'm the future king to this world.
  - Hey, take it easy I have feelings.
  - Mmm, I want more!
  - Much appreciated little one.
  crystalCost: {fileID: 38748035733871790}
  meter: {fileID: 7682969795490428125}
  meterPerc: {fileID: 38748035655667683}
  fusionLevel: {fileID: 38748036868221812}
  crystalsRemain: {fileID: 38748037219723192}
  closeButton: {fileID: 38748037386602449}
