    captions:
    - start: 0.45
      end: 4.18
      text: "\u70ED\u8336\u6696\u7740\u6307\u5C16\uFF0C\u5979\u7EC8\u4E8E\u677E\u4E0B\u4E86\u80A9\u8180\u3002"
    - start: 4.18
      end: 7.26
      text: "\u76EE\u5149\u5374\u53C8\u843D\u56DE\u90A3\u5F20\u5730\u56FE\u3002"
    - start: 8.08
      end: 10.16
      text: "\u201C\u662F\u4F60\u7684\u8BDD\uFF0C\u4E00\u5B9A\u53EF\u4EE5\u3002\u201D"
    - start: 10.96
      end: 16.28
      text: "\u7559\u4E0B\u8FD9\u53E5\u8BDD\u7684\u4EBA\uFF0C\u600E\u4E48\u77E5\u9053\u627E\u5230\u5730\u56FE\u7684\uFF0C\u4F1A\u662F\u8C01\uFF1F"
    silentDuration: 17.81034
