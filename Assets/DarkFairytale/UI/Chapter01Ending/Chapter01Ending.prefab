  m_EditorClassIdentifier: Assembly-CSharp::CursedBookPrologue
  intro: {fileID: 1235490630820550513}
  illustration: {fileID: 6395238689076137821}
  subtitle: {fileID: 6440403093246492334}
  openingText: {fileID: 1626655176379390727}
