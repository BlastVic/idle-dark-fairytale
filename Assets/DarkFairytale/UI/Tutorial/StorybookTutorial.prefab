--- !u!114 &2048137737212343340
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 150885632992232428}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b310f639768c948449778e3cfb667df6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StorybookTutorialUI
  steps:
  - title: "\u542F\u7A0B\uFF0C\u524D\u5F80\u9ED1\u68EE\u6797"
    body: "\u6253\u5F00\u5730\u56FE\uFF0C\u9009\u62E9\u7B2C\u4E00\u4E2A\u53EF\u6311\u6218\u8282\u70B9\uFF0C\n\u5F00\u59CB\u4F60\u7684\u63A2\u7D22\u3002"
    cue: "\u70B9\u51FB\u4E0B\u65B9\u300C\u5730\u56FE\u300D"
  - title: "\u9009\u62E9\u63A2\u7D22\u8282\u70B9"
    body: "\u6CBF\u7740\u6797\u95F4\u5C0F\u8DEF\uFF0C\n\u4ECE\u7B2C\u4E00\u4E2A\u53EF\u6311\u6218\u8282\u70B9\u5F00\u59CB\u3002"
    cue: "\u70B9\u51FB\u9AD8\u4EAE\u7684\u8282\u70B9"
  - title: "\u8BA9\u751F\u547D\u66F4\u52A0\u575A\u97E7"
    body: "\u4F7F\u7528\u83B7\u5F97\u7684\u5C5E\u6027\u70B9\uFF0C\n\u63D0\u5347\u751F\u547D\uFF0C\u4E3A\u4E0B\u4E00\u6B21\u63A2\u7D22\u505A\u51C6\u5907\u3002"
    cue: "\u70B9\u51FB\u751F\u547D\u65C1\u7684\u300C\uFF0B\u300D"
  - title: "\u67E5\u770B\u65C5\u9014\u7684\u6536\u83B7"
    body: "\u80CC\u5305\u91CC\u6709\u65B0\u7684\u88C5\u5907\u3002\n\u6311\u9009\u5408\u9002\u7684\u88C5\u5907\uFF0C\u63D0\u5347\u6218\u6597\u80FD\u529B\u3002"
    cue: "\u70B9\u51FB\u4E0B\u65B9\u300C\u88C5\u5907\u300D"
  - title: "\u7A7F\u6234\u65B0\u7684\u88C5\u5907"
    body: "\u6BD4\u8F83\u88C5\u5907\u5C5E\u6027\u4E0E\u6362\u88C5\u53D8\u5316\uFF0C\n\u786E\u8BA4\u540E\u5C06\u5B83\u88C5\u5907\u5230\u8EAB\u4E0A\u3002"
    cue: "\u70B9\u51FB\u300C\u88C5\u5907\u300D\u6309\u94AE"
  - title: "\u5206\u89E3\u591A\u4F59\u7684\u88C5\u5907"
    body: "\u5206\u89E3\u672A\u7A7F\u6234\u3001\u672A\u9501\u5B9A\u7684\u88C5\u5907\uFF0C\n\u53EF\u79EF\u7D2F\u878D\u5408\u8FDB\u5EA6\u3002\u786E\u8BA4\u524D\u4ECD\u53EF\u53D6\u6D88\u3002"
    cue: "\u70B9\u51FB\u300C\u5206\u89E3\u300D\u67E5\u770B\u786E\u8BA4\u4FE1\u606F"
  - title: "\u6253\u5F00\u63A2\u7D22\u7684\u5B9D\u7BB1"
    body: "\u6218\u6597\u5E26\u56DE\u4E86\u65B0\u7684\u5B9D\u7BB1\u3002\n\u6253\u5F00\u5B9D\u7BB1\uFF0C\u67E5\u770B\u65C5\u9014\u7684\u5956\u52B1\u3002"
    cue: "\u70B9\u51FB\u9AD8\u4EAE\u7684\u5B9D\u7BB1"
  - title: "\u878D\u5408\u4E4B\u529B\u5DF2\u82CF\u9192"
    body: "\u878D\u5408\u8FDB\u5EA6\u5DF2\u6EE1\uFF0C\n\u524D\u5F80\u878D\u5408\u9875\u9762\u9886\u53D6\u6210\u957F\u5956\u52B1\u3002"
    cue: "\u70B9\u51FB\u53F3\u4FA7\u300C\u878D\u5408\u300D"
  - title: "\u524D\u5F80\u5546\u5E97\u67E5\u770B"
    body: "\u8840\u6708\u7ED3\u6676\u4E0D\u8DB3\u65F6\uFF0C\n\u53EF\u524D\u5F80\u5546\u5E97\u4E86\u89E3\u83B7\u53D6\u65B9\u5F0F\u3002"
    cue: "\u70B9\u51FB\u4E0B\u65B9\u300C\u5546\u5E97\u300D"
